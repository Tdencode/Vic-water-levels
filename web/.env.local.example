# Copy to .env.local for local dev. On Vercel, set the same names in
# Project Settings -> Environment Variables.
#
# Use the project URL (no trailing /rest/v1) and the *anon* key — the site
# is public read-only and goes through RLS. Do NOT put the service_role
# key here; it would let any client write to the DB.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
